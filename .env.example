# Public Supabase project URL and publishable key only. Never include secret/service_role keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# HTTPS URL of the separate Python generator backend, NOT your Cloudflare site.
VITE_GENERATOR_API_URL=https://YOUR_PYTHON_BACKEND_HOST
